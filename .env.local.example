# In order to use Google Places Autocomplete, you need to create an API key
# from the Google Cloud Console.
# 1. Go to https://console.cloud.google.com/
# 2. Create a new project or select an existing one.
# 3. In the navigation menu, go to "APIs & Services" > "Credentials".
# 4. Click "Create Credentials" and select "API key".
# 5. Copy the generated API key.
# 6. Go to "Library" in the "APIs & Services" menu.
# 7. Search for "Places API" and enable it for your project.
# 8. Create a file named .env.local in the root of your project.
# 9. Add the following line to your .env.local file, replacing YOUR_API_KEY with the key you copied.

NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="YOUR_API_KEY"

# --- Google Drive Integration ---
# Per abilitare l'integrazione con Google Drive:
# 1. Vai su https://console.cloud.google.com/ > progetto ac-chiari-import-2024
# 2. Abilita: Google Drive API, Google Docs API
# 3. Crea credenziali OAuth 2.0 (tipo "Web application")
#    - Authorized redirect URI: http://localhost:3000/api/drive/callback (dev)
# 4. Copia Client ID e Client Secret qui sotto

GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/drive/callback"

# Opzionale: Service Account JSON per Firebase Admin SDK (production)
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account",...}'

# --- Firebase Cloud Messaging (Push Notifications) ---
# Per abilitare le push notification sul cellulare:
# 1. Vai su Firebase Console > Progetto > Project Settings > Cloud Messaging
# 2. Nella sezione "Web configuration", genera una coppia di chiavi VAPID
# 3. Copia la chiave pubblica qui sotto
# 4. Nella Firebase Console, abilita anche "Cloud Messaging API (Legacy)" se necessario

NEXT_PUBLIC_FIREBASE_VAPID_KEY="YOUR_VAPID_KEY_HERE"

# --- Promemoria automatici eventi (Cron Job) ---
# Stringa segreta per proteggere /api/send-event-reminders.
# Imposta un valore casuale lungo (es.: openssl rand -hex 32)
#
# Vercel la usa AUTOMATICAMENTE: se questa variabile è impostata nel
# dashboard Vercel, ogni invocazione cron includerà automaticamente
# l'header "Authorization: Bearer <CRON_SECRET>".
#
# Cron jobs configurati in vercel.json:
#   - 0 18 * * *  → /api/send-event-reminders?type=sera       (20:00 ora italiana)
#   - 0 10 * * *  → /api/send-event-reminders?type=mezzogiorno (12:00 ora italiana)
CRON_SECRET="YOUR_RANDOM_SECRET_HERE"
