{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "app-AC-Chiari/functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "runtime": "nodejs20"
    }
  ],
  "apphosting": [
    {
      "backendId": "studio",
      "ignore": [
        "node_modules",
        ".git",
        "*.local",
        "firebase-debug.*.log"
      ]
    }
  ]
}

