{
  "firestore": [
    {
      "database": "(default)",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    },
    {
      "database": "acbrescia",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    }
  ],
  "storage": {
    "rules": "storage.rules"
  },

  "functions": [
    {
      "source": "app-AC-Chiari/functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "runtime": "nodejs20"
    }
  ],
  "apphosting": [
    {
      "backendId": "studio",
      "ignore": [
        "node_modules",
        ".git",
        ".next",
        "*.local",
        "firebase-debug.*.log",
        "build.log",
        "scratch"
      ]
    }
  ]
}

